# ============================================================
# PV Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=pv_agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production  # production | staging | development

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Security ---
# Secret key for session/JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret-key
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Rate limit: max requests per window per client
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Redis (Cache & Session State) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# TTL for session data in seconds (default: 24 hours)
REDIS_SESSION_TTL=86400
# TTL for tool result cache in seconds (default: 5 minutes)
REDIS_TOOL_CACHE_TTL=300

# --- PostgreSQL (Persistence) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pv_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pv_agent
# SQLAlchemy connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- DeepSeek API ---
# Get your API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here
# OpenAI-compatible base URL (no trailing slash)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Primary model for reasoning and report generation
# Options: deepseek-v4-pro (旗舰), deepseek-v4-flash (高性价比)
DEEPSEEK_MODEL=deepseek-v4-flash
# Lightweight model for fast intent classification (same model, different params)
DEEPSEEK_LIGHT_MODEL=deepseek-v4-flash
# LLM generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# --- LangGraph ---
# Maximum graph recursion depth
LANGGRAPH_MAX_RECURSION=25
# Whether to persist checkpoints to PostgreSQL
LANGGRAPH_CHECKPOINT_PERSIST=true
# Checkpoint retention in days
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30
